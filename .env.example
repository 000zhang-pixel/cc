# =============================================
# 飞书应用凭证
# =============================================
LARK_APP_ID=cli_xxxxxxxxxxxxxxxx
LARK_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 飞书多维表格 Base Token（AI内容创作系统）
LARK_BASE_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# =============================================
# 文案模型 API Key
# =============================================
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
KIMI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# =============================================
# 图片模型
# =============================================
NANOBANANA_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NANOBANANA_BASE_URL=https://api.nanobanana.ai/v1
XIAOLE_API_KEY=xxxxxx...xxxx
XIAOLE_BASE_URL=https://api.xiaoleai.team
XIAOLE_IMAGE_ENDPOINT=/v1/image/created

# =============================================
# 视频模型
# =============================================
VEO_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
VEO_BASE_URL=https://api.veo.ai/v1
VOLCENGINE_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# =============================================
# 本地存储根目录
# 子目录结构（自动创建，勿修改子目录名）:
#   {LOCAL_STORAGE_ROOT}/
#   ├── inbox/            ← 原始素材输入区（用户手动放入实拍图片）
#   ├── Pending_Content/  ← 生成内容工作区（系统读写，发布引擎读取）
#   └── archive/          ← 发布归档区（发布成功后自动移入）
#
# Windows:
#   LOCAL_STORAGE_ROOT=D:/AI-Content-Hub/content-store
# Mac:
#   LOCAL_STORAGE_ROOT=/Users/${USER}/workspace/content-store
# =============================================
LOCAL_STORAGE_ROOT=/path/to/content-store

# =============================================
# 通知配置
# =============================================
NOTIFICATION_CHAT_ID=oc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
