LARK_APP_ID=cli_xxxxxxxxxxxxxxxx
LARK_APP_SECRET=xxxxxx...xxxx
LARK_BASE_TOKEN=Ei9jbc...Nnnb

# =============================================
# 文案模型 API Key
# =============================================
OPENAI_API_KEY=***
KIMI_API_KEY=***
DEEPSEEK_API_KEY=***

# =============================================
# 图片 / 视频模型
# =============================================
NANOBANANA_API_KEY=***
NANOBANANA_BASE_URL=https://api.nanobanana.ai/v1
