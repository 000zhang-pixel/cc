{
  "version": "2026-04-24",
  "name": "feishu_interactive_01_accept_short",
  "description": "短模板版 01 受理。用于首接需求、子任务受理、快速建立正式状态。",
  "message_type": "accept",
  "message_code": "01",
  "label": "受理",
  "detail_level": "short",
  "msg_type": "interactive",
  "card": {
    "config": {"wide_screen_mode": true, "enable_forward": true},
    "header": {
      "template": "blue",
      "title": {"tag": "plain_text", "content": "{title_prefix}｜01 受理"},
      "subtitle": {"tag": "plain_text", "content": "短模板 · {task_name}"}
    },
    "elements": [
      {"tag": "markdown", "content": "**✦ 已受理**\n事项｜{task_name}\n责任人｜{owner_mention}\n下一责任人｜{next_owner_mentions}"},
      {"tag": "hr"},
      {"tag": "markdown", "content": "**◔ 当前状态**\n状态｜{status}\n下一节点｜{next_milestone}"},
      {"tag": "hr"},
      {"tag": "markdown", "content": "**☰ 动作**\n{actions_md}"},
      {"tag": "hr"},
      {"tag": "markdown", "content": "**receipt｜**以回读与 mention 验证为准。"}
    ]
  },
  "default_values": {
    "next_owner_mentions": "-"
  },
  "business_sections": {
    "actions": {
      "render_key": "actions_md",
      "legacy_prefix": "action_item_",
      "max_items": 2,
      "required": true
    }
  },
  "required_placeholders": ["title_prefix", "task_name", "owner_mention", "status", "next_milestone", "actions_md"]
}
