{
  "version": "2026-04-24",
  "name": "feishu_interactive_03_ack_short",
  "description": "短模板版 03 接单。用于主责首响，先建立可观察状态。",
  "message_type": "ack",
  "message_code": "03",
  "label": "接单",
  "detail_level": "short",
  "msg_type": "interactive",
  "card": {
    "config": {"wide_screen_mode": true, "enable_forward": true},
    "header": {
      "template": "turquoise",
      "title": {"tag": "plain_text", "content": "{title_prefix}｜03 接单"},
      "subtitle": {"tag": "plain_text", "content": "短模板 · {task_name}"}
    },
    "elements": [
      {"tag": "markdown", "content": "**✦ 已接单**\n事项｜{task_name}\n责任人｜{owner_mention}"},
      {"tag": "hr"},
      {"tag": "markdown", "content": "**◔ 当前状态**\n状态｜{status}\n首次回报｜{progress_deadline}"},
      {"tag": "hr"},
      {"tag": "markdown", "content": "**☰ 动作**\n{actions_md}"},
      {"tag": "hr"},
      {"tag": "markdown", "content": "**receipt｜**以回读与 mention 验证为准。"}
    ]
  },
  "business_sections": {
    "actions": {
      "render_key": "actions_md",
      "legacy_prefix": "action_item_",
      "max_items": 2,
      "required": true
    }
  },
  "required_placeholders": ["title_prefix", "task_name", "owner_mention", "status", "progress_deadline", "actions_md"]
}
