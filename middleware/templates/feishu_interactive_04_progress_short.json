{
  "version": "2026-04-24",
  "name": "feishu_interactive_04_progress_short",
  "description": "短模板版 04 进展。用于微进展同步和阶段压缩回报。",
  "message_type": "progress",
  "message_code": "04",
  "label": "进展",
  "detail_level": "short",
  "msg_type": "interactive",
  "card": {
    "config": {"wide_screen_mode": true, "enable_forward": true},
    "header": {
      "template": "indigo",
      "title": {"tag": "plain_text", "content": "{title_prefix}｜04 进展"},
      "subtitle": {"tag": "plain_text", "content": "短模板 · {task_name}"}
    },
    "elements": [
      {"tag": "markdown", "content": "**✦ 本次进展**\n责任人｜{owner_mention}\n- {deliverable_1}\n- {deliverable_2}"},
      {"tag": "hr"},
      {"tag": "markdown", "content": "**◔ 当前状态**\n状态｜{status}\n下一节点｜{next_milestone}"},
      {"tag": "hr"},
      {"tag": "markdown", "content": "**☰ 动作**\n{actions_md}"},
      {"tag": "hr"},
      {"tag": "markdown", "content": "**receipt｜**以回读与 mention 验证为准。"}
    ]
  },
  "business_sections": {
    "actions": {
      "render_key": "actions_md",
      "legacy_prefix": "action_item_",
      "max_items": 2,
      "required": true
    }
  },
  "required_placeholders": ["title_prefix", "task_name", "owner_mention", "deliverable_1", "deliverable_2", "status", "next_milestone", "actions_md"]
}
