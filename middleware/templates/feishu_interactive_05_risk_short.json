{
  "version": "2026-04-24",
  "name": "feishu_interactive_05_risk_short",
  "description": "短模板版 05 风险。用于先报警、后补完整风险卡。",
  "message_type": "risk",
  "message_code": "05",
  "label": "风险",
  "detail_level": "short",
  "msg_type": "interactive",
  "card": {
    "config": {"wide_screen_mode": true, "enable_forward": true},
    "header": {
      "template": "red",
      "title": {"tag": "plain_text", "content": "{title_prefix}｜05 风险"},
      "subtitle": {"tag": "plain_text", "content": "短模板 · {task_name}"}
    },
    "elements": [
      {"tag": "markdown", "content": "**✦ 风险点**\n问题｜{risk_1}\n责任人｜{owner_mention}"},
      {"tag": "hr"},
      {"tag": "markdown", "content": "**◔ 影响与时点**\n影响｜{impact_1}\n决策人｜{decision_maker_mentions}\n决策时点｜{deadline}"},
      {"tag": "hr"},
      {"tag": "markdown", "content": "**☰ 动作**\n{actions_md}"},
      {"tag": "hr"},
      {"tag": "markdown", "content": "**receipt｜**以回读与 mention 验证为准。"}
    ]
  },
  "default_values": {
    "decision_maker_mentions": "-"
  },
  "business_sections": {
    "actions": {
      "render_key": "actions_md",
      "legacy_prefix": "action_item_",
      "max_items": 2,
      "required": true
    }
  },
  "required_placeholders": ["title_prefix", "task_name", "owner_mention", "risk_1", "impact_1", "deadline", "actions_md"]
}
