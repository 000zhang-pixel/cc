{
  "version": "2026-04-24",
  "name": "feishu_interactive_06_followup_short",
  "description": "短模板版 06 催办。用于轻量催办和首轮追时效。",
  "message_type": "followup",
  "message_code": "06",
  "label": "催办",
  "detail_level": "short",
  "msg_type": "interactive",
  "card": {
    "config": {"wide_screen_mode": true, "enable_forward": true},
    "header": {
      "template": "orange",
      "title": {"tag": "plain_text", "content": "{title_prefix}｜06 催办"},
      "subtitle": {"tag": "plain_text", "content": "短模板 · {task_name}"}
    },
    "elements": [
      {"tag": "markdown", "content": "**✦ 催办事项**\n事项｜{task_name}\n责任人｜{owner_mention}"},
      {"tag": "hr"},
      {"tag": "markdown", "content": "**◔ 时点**\n下一责任人｜{next_owner_mentions}\n回报时点｜{progress_deadline}\n最晚时限｜{deadline}"},
      {"tag": "hr"},
      {"tag": "markdown", "content": "**☰ 动作**\n{actions_md}"},
      {"tag": "hr"},
      {"tag": "markdown", "content": "**receipt｜**以回读与 mention 验证为准。"}
    ]
  },
  "default_values": {
    "next_owner_mentions": "-"
  },
  "business_sections": {
    "actions": {
      "render_key": "actions_md",
      "legacy_prefix": "action_item_",
      "max_items": 2,
      "required": true
    }
  },
  "required_placeholders": ["title_prefix", "task_name", "owner_mention", "progress_deadline", "deadline", "actions_md"]
}
